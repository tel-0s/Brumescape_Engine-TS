// A new main-screen interface that uses new sprites (if_scroll, if_buttons, if_badge)
[background]
type=graphic
x=0
y=0
width=64
height=32
graphic=if_scroll,0

[frame]
type=layer
x=20
y=40
width=300
height=120
scroll=200

[title]
layer=frame
type=text
x=0
y=0
width=300
height=20
center=yes
font=q8
text=Fixture Journal
colour=0x800000

// y=end+N stacks below the previous component in the same layer
[line1]
layer=frame
type=text
x=10
y=end+4
width=280
height=14
font=p12
text=First line
colour=0x000000

[line2]
layer=frame
type=text
x=10
y=end+2
width=280
height=14
font=p12
text=Second line
colour=0x000000

[badge]
type=graphic
x=340
y=40
width=20
height=20
graphic=if_badge,0

[ok]
type=graphic
x=440
y=280
width=16
height=16
buttontype=normal
option=Close journal
graphic=if_buttons,0
activegraphic=if_buttons,1

[icon]
type=model
x=400
y=100
width=40
height=40
model=model_3042
zoom=1200
xan=500
