// Only the listed properties change; everything else stays as base content has it.
[man]
name=Bob
op3=Steal-from
-op2
// param is a list keyed by the param name: replace one, remove one, add one
param=stabdefence,5
-param=slashdefence
param=patch_demo_flag,1
vislevel=5

